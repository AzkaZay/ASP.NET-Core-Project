@model List<PatisserieCD.Models.Product>

<h1>Products</h1>

@foreach (var product in Model)
{
    <h2>
        <a asp-controller="Products"
           asp-action="Details"
           asp-route-id="@product.Id">
            @product.Name
        </a>
    </h2>

    <p>@product.Description</p>

    <p>Price: @product.UnitPrice</p>

    <p>Preparation time: @product.PreparationLeadTimeHours hours</p>
}