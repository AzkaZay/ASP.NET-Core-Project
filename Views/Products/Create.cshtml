@model PatisserieCD.Models.Product

<h1>Create Product</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>

    <div>
        <label asp-for="Description"></label>
        <input asp-for="Description" />
    </div>

    <div>
        <label asp-for="UnitPrice"></label>
        <input asp-for="UnitPrice" />
    </div>

    <div>
        <label asp-for="PreparationLeadTimeHours"></label>
        <input asp-for="PreparationLeadTimeHours" />
    </div>

    <div>
        <label asp-for="Photo"></label>
        <input asp-for="Photo" />
    </div>

    <div>
        <label asp-for="IsAvailable"></label>
        <input asp-for="IsAvailable" type="checkbox" />
    </div>

    <button type="submit">Create</button>

</form>